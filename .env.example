# Supabase Configuration
# Get these values from: https://app.supabase.com/project/_/settings/api
# 
# 1. Go to your Supabase project dashboard
# 2. Navigate to Settings → API
# 3. Copy the Project URL and anon/public key
# 4. Replace the placeholder values below
# 5. Rename this file to .env (remove .example)
# 6. Restart your Expo dev server after creating/updating .env

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Note: The EXPO_PUBLIC_ prefix is required for Expo to expose these variables
# to your React Native code. Never commit your actual .env file to git.

# Sentry Error Tracking (Optional - for production error monitoring)
# Get your DSN from: https://sentry.io/settings/[your-org]/projects/[your-project]/keys/
# Only errors in production will be sent (not in development mode)
EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn-here

# Google Sign-In (Native flow via @react-native-google-signin/google-signin)
# Create OAuth clients in Google Cloud Console → APIs & Services → Credentials:
#  - Web client ID (used by Supabase + passed as webClientId to GoogleSignin.configure)
#  - iOS client ID (bundle ID must match app.json ios.bundleIdentifier)
# Android client is registered via package name + SHA-1; no ID needed in code.
# These values are public (embedded in the app binary), so the EXPO_PUBLIC_ prefix is safe.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
